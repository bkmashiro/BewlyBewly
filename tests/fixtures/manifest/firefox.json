{
  "manifest_version": 3,
  "name": "BewlyBewly",
  "description": "Just make a few small changes to your Bilibili homepage.",
  "version": "0.41.1",
  "homepage_url": "https://github.com/hakadao/BewlyBewly",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "scripts": ["./dist/background/index.js"]
  },
  "permissions": ["storage", "declarativeNetRequest", "tabs", "webRequest", "webRequestBlocking", "cookies"],
  "host_permissions": ["*://*.bilibili.com/*", "*://*.hdslb.com/*"],
  "content_scripts": [
    {
      "matches": ["*://www.bilibili.com/*", "*://search.bilibili.com/*", "*://t.bilibili.com/*", "*://space.bilibili.com/*", "*://message.bilibili.com/*", "*://member.bilibili.com/*", "*://account.bilibili.com/*", "*://www.hdslb.com/*", "*://passport.bilibili.com/*", "*://music.bilibili.com/*"],
      "js": ["./dist/contentScripts/index.global.js"],
      "css": ["./dist/contentScripts/style.css"],
      "run_at": "document_start",
      "match_about_blank": true,
      "all_frames": true
    },
    {
      "matches": ["*://www.bilibili.com/*", "*://search.bilibili.com/*", "*://t.bilibili.com/*", "*://space.bilibili.com/*", "*://message.bilibili.com/*", "*://member.bilibili.com/*", "*://account.bilibili.com/*", "*://www.hdslb.com/*", "*://passport.bilibili.com/*", "*://music.bilibili.com/*"],
      "js": ["./dist/inject/index.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [{ "resources": ["dist/contentScripts/style.css", "assets/*"], "matches": ["<all_urls>"] }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" },
  "browser_specific_settings": {
    "gecko": {
      "id": "addon@bewlybewly.com",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
