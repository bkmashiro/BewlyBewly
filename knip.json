{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "paths": {
    "~/*": ["src/*"]
  },
  "entry": [
    "src/entrypoints/**/*.ts",
    "src/components/**",
    "*.config.*"
  ],
  "ignoreDependencies": [
    "@iconify/json",
    "uno.css"
  ],
  "rules": {
    "types": "off",
    "enumMembers": "off",
    "exports": "off"
  }
}
