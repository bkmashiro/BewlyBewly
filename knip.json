{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "paths": {
    "~/*": ["src/*"]
  },
  "entry": [
    "src/entrypoints/**/*.ts",
    "src/components/**",
    "*.config.*"
  ],
  "ignore": ["src/components/Settings/**"],
  "ignoreDependencies": [
    "@iconify/json",
    "esbuild",
    "uno.css",
    "lint-staged",
    "sass",
    "terser"
  ],
  "ignoreBinaries": ["gh", "xcrun"],
  "rules": {
    "types": "off",
    "enumMembers": "off",
    "exports": "off"
  }
}
