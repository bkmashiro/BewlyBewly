{
  "plugins": {
    "release-it-pnpm": {
      "publishCommand": "echo 'skipping publish'"
    }
  },
  "git": {
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}"
  },
  "hooks": {
    "before:init": [
      "pnpm run lint",
      "pnpm run typecheck",
      "pnpm run test"
    ],
    "after:bump": [
      "pnpm run zip",
      "pnpm run zip:firefox"
    ],
    "after:release": [
      "gh release upload v${version} .output/*-chrome.zip .output/*-firefox.zip .output/*-sources.zip",
      "pnpm run submit"
    ]
  }
}
