{
  "name": "bewly-bewly",
  "displayName": "BewlyBewly",
  "type": "module",
  "version": "0.41.1",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "description": "Just make a few small changes to your Bilibili homepage.",
  "homepage": "https://github.com/hakadao/BewlyBewly",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "wxt --mv3",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:safari": "wxt build -b safari --mv3",
    "zip": "wxt zip --mv3",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "submit": "wxt submit",
    "convert:safari": "xcrun safari-web-extension-converter ./.output/safari-mv3 --project-location ./extension-safari-macos --macos-only",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run --exclude tests/manifest-contract.spec.ts",
    "test:manifest": "pnpm build && pnpm build:firefox && vitest run tests/manifest-contract.spec.ts",
    "test:watch": "vitest --exclude tests/manifest-contract.spec.ts",
    "typecheck": "wxt prepare && vue-tsc",
    "postinstall": "wxt prepare && simple-git-hooks",
    "knip": "knip"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "@vueuse/core": "^14.4.0",
    "dompurify": "^3.4.12",
    "md5": "^2.3.0",
    "mitt": "^3.0.1",
    "overlayscrollbars": "2.16.0",
    "overlayscrollbars-vue": "^0.5.10",
    "pinia": "^4.0.2",
    "qrcode.vue": "^3.10.0",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.8",
    "vue-toastification": "2.0.0-rc.5",
    "vuedraggable": "^4.1.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@iconify/json": "^2.2.508",
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@types/md5": "^2.3.6",
    "@types/node": "^24.13.3",
    "@types/webextension-polyfill": "^0.12.5",
    "@unocss/preset-attributify": "^66.7.5",
    "@wxt-dev/module-vue": "1.0.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-format": "^2.0.1",
    "jsdom": "^30.0.1",
    "knip": "^6.31.0",
    "lint-staged": "^17.3.0",
    "release-it": "^21.0.1",
    "sass": "^1.102.0",
    "simple-git-hooks": "^2.13.1",
    "terser": "^5.49.0",
    "typescript": "^6.0.3",
    "unocss": "66.7.5",
    "unplugin-auto-import": "^21.0.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "webExt": {
    "run": {
      "keepProfileChanges": true,
      "firefoxProfile": "./web-ext-profile",
      "chromiumProfile": "./web-ext-profile",
      "startUrl": [
        "https://www.bilibili.com/"
      ]
    }
  }
}
