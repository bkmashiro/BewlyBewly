{
  "name": "bewly-bewly",
  "displayName": "BewlyBewly",
  "type": "module",
  "version": "0.41.1",
  "private": true,
  "packageManager": "pnpm@9.5.0",
  "description": "Just make a few small changes to your Bilibili homepage.",
  "homepage": "https://github.com/hakadao/BewlyBewly",
  "scripts": {
    "dev": "wxt --mv3",
    "dev:firefox": "wxt -b firefox --mv3",

    "build": "wxt build --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:safari": "wxt build -b safari --mv3",
    "zip": "wxt zip --mv3",
    "zip:firefox": "wxt zip -b firefox --mv3",

    "submit": "wxt submit",
    "convert:safari": "xcrun safari-web-extension-converter ./.output/safari-mv3 --project-location ./extension-safari-macos --macos-only",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run --exclude tests/manifest-contract.spec.ts",
    "test:manifest": "pnpm build && pnpm build:firefox && vitest run tests/manifest-contract.spec.ts",
    "test:watch": "vitest --exclude tests/manifest-contract.spec.ts",
    "typecheck": "wxt prepare && vue-tsc",
    "postinstall": "wxt prepare && simple-git-hooks",
    "knip": "knip"
  },
  "dependencies": {
    "@types/md5": "^2.3.5",
    "dompurify": "^3.1.5",
    "md5": "^2.3.0",
    "mitt": "^3.0.1",
    "overlayscrollbars": "2.7.3",
    "overlayscrollbars-vue": "^0.5.9",
    "pinia": "^2.1.7",
    "qrcode.vue": "^3.4.1",
    "vue-i18n": "^9.13.1",
    "vue-toastification": "2.0.0-rc.5",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.21.1",
    "@iconify/json": "^2.2.219",
    "@iconify/vue": "^4.1.2",
    "@intlify/unplugin-vue-i18n": "^4.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.1.2",
    "@types/webextension-polyfill": "^0.10.7",
    "@unocss/preset-attributify": "^66.7.5",
    "@vueuse/core": "^10.11.0",
    "@wxt-dev/module-vue": "1.0.3",
    "esbuild": "^0.27.0",
    "eslint": "^9.4.0",
    "eslint-plugin-format": "^0.1.2",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "jsdom": "^24.1.0",
    "knip": "^5.19.0",
    "lint-staged": "^15.2.7",
    "release-it": "^17.3.0",
    "release-it-pnpm": "^4.6.1",
    "sass": "^1.77.5",
    "simple-git-hooks": "^2.11.1",
    "terser": "^5.31.1",
    "typescript": "^5.9.3",
    "unocss": "66.7.5",
    "unplugin-auto-import": "^0.17.6",
    "vite": "^8.0.2",
    "vitest": "^1.6.1",
    "vue": "^3.4.27",
    "vue-tsc": "^3.1.0",
    "web-ext": "^10.5.0",
    "webext-bridge": "5.0.5",
    "webextension-polyfill": "^0.12.0",
    "wxt": "^0.21.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "webExt": {
    "run": {
      "keepProfileChanges": true,
      "firefoxProfile": "./web-ext-profile",
      "chromiumProfile": "./web-ext-profile",
      "startUrl": [
        "https://www.bilibili.com/"
      ]
    }
  }
}
